generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  role       String
  department String?
  phone      String?
  customers  Customer[]
  visits     Visit[]
  auditLogs  AuditLog[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Customer {
  id                 String   @id @default(uuid())
  name               String
  company            String
  email              String?
  phone              String?
  location           String?
  industry           String?
  dealValue          Float?
  relationshipHealth Int?
  humanTouchScore    Int?
  priority           String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  status             String   @default("ACTIVE") // ACTIVE, INACTIVE, PROSPECT, CUSTOMER, AT_RISK
  
  assignedUserId     String?
  assignedUser       User?    @relation(fields: [assignedUserId], references: [id])
  
  interactions       Interaction[]
  aiAnalyses         AIAnalysis[]
  recommendations    Recommendation[]
  visits             Visit[]
  automationLogs     AutomationLog[]
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Interaction {
  id              String   @id @default(uuid())
  customerId      String
  userId          String?
  type            String   // EMAIL, CALL, MEETING, MESSAGE, SUPPORT, VISIT
  subject         String?
  content         String?
  sentiment       String?  // POSITIVE, NEUTRAL, NEGATIVE
  urgency         String?  // LOW, MEDIUM, HIGH, CRITICAL
  resolved        Boolean  @default(false)
  interactionDate DateTime @default(now())
  
  customer        Customer @relation(fields: [customerId], references: [id])
  
  createdAt       DateTime @default(now())
}

model AIAnalysis {
  id                 String   @id @default(uuid())
  customerId         String
  interactionId      String?
  sentiment          String?
  urgency            String?
  relationshipHealth Int?
  humanTouchScore    Int?
  priority           String?
  recommendedAction  String?  // AUTOMATED_COMMUNICATION, FOLLOW_UP, SALES_CALL, PHYSICAL_VISIT, ESCALATION
  confidence         Float?
  reasons            Json?
  
  customer           Customer @relation(fields: [customerId], references: [id])
  recommendations    Recommendation[]
  
  createdAt          DateTime @default(now())
}

model Recommendation {
  id              String   @id @default(uuid())
  customerId      String
  analysisId      String?
  action          String
  priority        String
  title           String
  description     String?
  reason          String?
  status          String   @default("PENDING") // PENDING, ACCEPTED, COMPLETED, REJECTED, EXPIRED
  recommendedFor  DateTime?
  
  customer        Customer @relation(fields: [customerId], references: [id])
  aiAnalysis      AIAnalysis? @relation(fields: [analysisId], references: [id])
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Visit {
  id             String   @id @default(uuid())
  customerId     String
  assignedUserId String?
  scheduledDate  DateTime
  scheduledTime  String?
  location       String?
  objective      String?
  talkingPoints  Json?
  priority       String?
  status         String   @default("PLANNED") // PLANNED, CONFIRMED, COMPLETED, CANCELLED
  
  customer       Customer @relation(fields: [customerId], references: [id])
  assignedUser   User?    @relation(fields: [assignedUserId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AutomationLog {
  id               String   @id @default(uuid())
  customerId       String
  recommendationId String?
  actionType       String
  message          String?
  status           String
  executedAt       DateTime @default(now())
  
  customer         Customer @relation(fields: [customerId], references: [id])
  
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  details    Json?
  
  user       User?    @relation(fields: [userId], references: [id])
  
  createdAt  DateTime @default(now())
}